# Local DB
DATABASE_URL=postgresql://admin:admin@localhost:5432/knowledge_db

DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_NAME=knowledge_db
DB_POSTGRES_USER=admin
DB_POSTGRES_PASSWORD=admin

# Qdrant
QDRANT_URI=http://localhost:6333

# Neo4J
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# S3 credentials (Yandex Object Storage)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-central1
S3_BUCKET_NAME=
S3_ENDPOINT_URL=https://storage.yandexcloud.net

# Yandex Cloud AI
YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_MODEL=yandexgpt/latest
YANDEX_CLOUD_OAUTH_TOKEN=

YANDEX_CLOUD_AI_BASE_URL=https://rest-assistant.api.cloud.yandex.net/v1
YANDEX_CLOUD_AI_FOLDER=

ALLOWED_HOSTS=["http://localhost", "https://localhost"]
CORS_ORIGINS=["http://localhost:3000"]

ENVIRONMENT=dev

# LLM provider (RouterAI / OpenRouter / any OpenAI-compatible)
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODEL=anthropic/claude-sonnet-4.5
